# API and Website URLs
# In development, both should be http://localhost:3000
# In production, set these to your deployed frontend URL (e.g., https://nexus-nft-example.vercel.app/)
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Pinata Configuration
# Get these values from your Pinata Gateway (https://app.pinata.cloud/gateway)
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=your_gateway.mypinata.cloud
NEXT_PUBLIC_PINATA_GATEWAY=your_gateway.mypinata.cloud

# ── Base Notifications ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
BASE_API_KEY=your_base_api_key_here
